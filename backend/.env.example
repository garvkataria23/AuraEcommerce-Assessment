# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/auraecommerce?retryWrites=true&w=majority

# JWT secret for authentication tokens
JWT_SECRET=your-super-secret-key-change-this

# Groq API key for AI shopping assistant
GROQ_API_KEY=gsk_your_api_key_here

# Port (Render sets this automatically; optional for local dev)
PORT=10000
